// Motorola's patched framework.jar ships com.motorola.internal.app.IMotoFaceService*; Lineage's does
// not, which makes MotoFaceUnlockArcSoft crash in FaceAuthService.onCreate (NoClassDefFoundError).
// Provide the classes as a shared library that moto-core_services declares a dependency on.
java_library {
    name: "moto-face-framework",
    system_ext_specific: true,
    installable: true,
    platform_apis: true,
    srcs: [
        "aidl/**/*.aidl",
        "src/**/*.kt",
    ],
    aidl: { local_include_dirs: ["aidl"] },
    kotlincflags: ["-Xno-param-assertions", "-Xno-call-assertions", "-Xno-receiver-assertions"],
    dex_preopt: { enabled: false },
    required: [
        "moto-face-framework.xml",
        "moto-core_services.xml",
    ],
}

prebuilt_etc {
    name: "moto-face-framework.xml",
    system_ext_specific: true,
    src: "moto-face-framework.xml",
    sub_dir: "permissions",
}

// Replaces the stock system/etc/permissions/moto-core_services.xml (do NOT also take that blob):
// identical library, plus the dependency on moto-face-framework.
prebuilt_etc {
    name: "moto-core_services.xml",
    system_ext_specific: true,
    src: "moto-core_services.xml",
    sub_dir: "permissions",
}
